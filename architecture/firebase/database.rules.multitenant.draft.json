{
  "rules": {
    "tenantMemberships": {
      "$tenantId": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || auth.token.platformAdmin == true)",
          ".write": false
        }
      }
    },
    "tenants": {
      "$tenantId": {
        ".read": "auth != null && root.child('tenantMemberships').child($tenantId).child(auth.uid).child('active').val() == true && root.child('platform/tenantDirectory').child($tenantId).child('status').val() == 'active' && (root.child('platformBilling').child($tenantId).child('status').val() == 'active' || root.child('platformBilling').child($tenantId).child('status').val() == 'trial')",
        "profile": {
          ".write": "auth != null && root.child('tenantMemberships').child($tenantId).child(auth.uid).child('active').val() == true && root.child('platform/tenantDirectory').child($tenantId).child('status').val() == 'active' && (root.child('platformBilling').child($tenantId).child('status').val() == 'active' || root.child('platformBilling').child($tenantId).child('status').val() == 'trial') && (root.child('tenantMemberships').child($tenantId).child(auth.uid).child('role').val() == 'owner' || root.child('tenantMemberships').child($tenantId).child(auth.uid).child('role').val() == 'admin')"
